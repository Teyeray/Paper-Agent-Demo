# 使用Python 3.11官方镜像
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 安装uv
RUN pip install uv -i https://pypi.tuna.tsinghua.edu.cn/simple

# 复制项目文件
COPY pyproject.toml uv.lock ./

# 安装Python依赖
RUN uv sync --frozen

# 复制应用代码
COPY agent_camel.py ./
COPY start_agent.sh ./

# 设置执行权限
RUN chmod +x start_agent.sh

# 设置环境变量
ENV DEEPSEEK_API_KEY=""
ENV MCP_URL="http://localhost:50003/my-custom-path/"
ENV MCP_MODE="http"

# 启动命令
CMD ["bash"] 